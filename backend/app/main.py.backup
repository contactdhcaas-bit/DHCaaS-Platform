    allow_origins=[
        "http://localhost:5173",
        "http://localhost:3000",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:3000",
        "http://localhost:5174",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
    expose_headers=["*"],
    max_age=3600,
)


# ============================================================
# API ROUTER REGISTRATION - CORRECT ORDER
# ============================================================
# Authentication router MUST be registered FIRST
app.include_router(auth.router, prefix=settings.API_V1_STR)

# Main API router
app.include_router(api_router, prefix=settings.API_V1_STR)

# Remediation router
app.include_router(
    remediation.router, 
    prefix=f"{settings.API_V1_STR}/remediation", 
    tags=["remediation"]
)

# Reports router
app.include_router(reports.router)


