    print("=" * 70)
    print("✅ Shutdown Complete")
    print("=" * 70 + "\n")


# ============================================================
# ERROR HANDLERS
# ============================================================

@app.exception_handler(StarletteHTTPException)
async def http_exception_handler(request: Request, exc: StarletteHTTPException):
    """Global HTTP exception handler"""
    return JSONResponse(
        status_code=exc.status_code,
        content={
            "error": True,
            "message": exc.detail,
            "status_code": exc.status_code,
            "path": str(request.url)
        }
    )


@app.exception_handler(RequestValidationError)
async def validation_exception_handler(request: Request, exc: RequestValidationError):
    """Global validation error handler"""
    return JSONResponse(
        status_code=422,
        content={
            "error": True,
            "message": "Validation error",
            "details": exc.errors(),
            "path": str(request.url)
        }
    )


@app.exception_handler(Exception)
async def general_exception_handler(request: Request, exc: Exception):
    """Global exception handler for uncaught exceptions"""
    return JSONResponse(
        status_code=500,
        content={
            "error": True,
            "message": "Internal server error",
            "details": str(exc),
            "path": str(request.url)
        }
    )


# ============================================================
# LINEAGE ENDPOINT - FAILSAFE IMPLEMENTATION WITH 2s TIMEOUT
# ============================================================

from app.api.v1.endpoints.lineage import router as lineage_router
from app.api.v1.endpoints.lineage import LineageResponse, LineageNodeOut
from datetime import datetime
import sys
from pathlib import Path

print("\n" + "=" * 70)
print("🔌 INITIALIZING DATABASE CONNECTION FOR LINEAGE")
print("=" * 70)

scans_col = None
DB_AVAILABLE = False
DB_ERROR_MESSAGE = None

project_root = Path(__file__).parent.parent
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))
    print(f"✓ Added to sys.path: {project_root}")

try:
    print("⏳ Attempting import: from database import scans_col...")
    from database import scans_col
    DB_AVAILABLE = True
    print("✅ SUCCESS: Database module imported successfully")
    print(f"   Collection type: {type(scans_col)}")
except ImportError as e:
    print(f"⚠️  WARNING: Could not import from database")
    print(f"   Reason: {str(e)}")
    DB_ERROR_MESSAGE = f"ImportError: {str(e)}"
    
    try:
        print("⏳ Attempting fallback: from app.database import scans_col...")
        from app.database import scans_col
        DB_AVAILABLE = True
        print("✅ SUCCESS: Database module imported via app.database")
    except ImportError as e2:
        print(f"❌ FAILED: All import attempts failed")
        print(f"   Reason: {str(e2)}")
        DB_ERROR_MESSAGE = f"All imports failed: {str(e2)}"
        scans_col = None
        DB_AVAILABLE = False
except Exception as e:
    print(f"❌ CRITICAL ERROR during import: {type(e).__name__}")
    print(f"   Details: {str(e)}")
    DB_ERROR_MESSAGE = f"Exception: {str(e)}"
    scans_col = None
    DB_AVAILABLE = False

print(f"📊 Database Status: {'✓ AVAILABLE' if DB_AVAILABLE else '✗ UNAVAILABLE'}")
if not DB_AVAILABLE:
    print(f"⚡ FAILSAFE MODE: Will use mock data for all lineage requests")
print("=" * 70 + "\n")

app.include_router(lineage_router, prefix=f"{settings.API_V1_STR}/lineage", tags=["Lineage"])


async def fetch_real_data_with_timeout():
    """Fetch real data from MongoDB with strict 2-second timeout"""
    if not DB_AVAILABLE or scans_col is None:
        raise RuntimeError("Database not available")
    
    cursor = scans_col.find({}).sort("created_at", -1).limit(6)
    scans = await cursor.to_list(length=6)
    return scans


def generate_mock_data():
    """Generate guaranteed mock data instantly"""
    source_node = LineageNodeOut(
        id='warehouse-source',
        label='Data Warehouse',
        type='source',
        x=100,
        y=300,
        qualityScore=None,
        hasPII=None,
        owner=None,
        lastScan=None
    )
    
    mock_tables = [
        LineageNodeOut(
            id='mock-table-001',
            label='customers_data.csv',
            type='table',
            x=600,
            y=50,
            qualityScore=95.2,
            hasPII=True,
            owner='Analytics Team',
            lastScan='2026-02-12'
        ),
        LineageNodeOut(
            id='mock-table-002',
            label='orders_history.csv',
            type='table',
            x=600,
            y=200,
            qualityScore=78.5,
            hasPII=False,
            owner='Analytics Team',
            lastScan='2026-02-12'
        ),
        LineageNodeOut(
            id='mock-table-003',
            label='products_catalog.csv',
            type='table',
            x=600,
            y=350,
            qualityScore=88.3,
            hasPII=False,
            owner='Product Team',
            lastScan='2026-02-11'
        )
    ]
    
    mock_nodes = [source_node] + mock_tables
    
    mock_edges = [
        {"id": "edge-mock-001", "source": "warehouse-source", "target": "mock-table-001"},
        {"id": "edge-mock-002", "source": "warehouse-source", "target": "mock-table-002"},
        {"id": "edge-mock-003", "source": "warehouse-source", "target": "mock-table-003"}
    ]
    
    return LineageResponse(nodes=mock_nodes, edges=mock_edges)


@app.get(f'{settings.API_V1_STR}/lineage', response_model=LineageResponse)
async def get_lineage_direct():
    """FAILSAFE LINEAGE ENDPOINT - GUARANTEED 2-SECOND RESPONSE"""
    
    start_time = asyncio.get_event_loop().time()
    print(f"\n{'='*70}")
    print(f"📊 LINEAGE REQUEST - FAILSAFE MODE")
    print(f"{'='*70}")
    print(f"Timestamp: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"Database Available: {DB_AVAILABLE}")
    
    if not DB_AVAILABLE or scans_col is None:
        print(f"⚡ FAST FAILOVER: Database unavailable, using mock data")
        print(f"   Error: {DB_ERROR_MESSAGE}")
        print(f"{'='*70}\n")
        return generate_mock_data()
    
    try:
        print(f"🔍 Attempting real data fetch (timeout: 2.0s)...")
        
        scans = await asyncio.wait_for(
            fetch_real_data_with_timeout(),
            timeout=2.0
        )
        
        scan_count = len(scans)
        fetch_time = asyncio.get_event_loop().time() - start_time
        print(f"✅ SUCCESS: Fetched {scan_count} scans in {fetch_time:.2f}s")
        
        if scan_count == 0:
            print(f"⚠️  No scans in database, using mock data")
            print(f"{'='*70}\n")
            return generate_mock_data()
        
        nodes = []
        edges = []
        
        source_node = LineageNodeOut(
            id='warehouse-source',
            label='Data Warehouse',
            type='source',
            x=100,
            y=300,
            qualityScore=None,
            hasPII=None,
            owner=None,
            lastScan=None
        )
        nodes.append(source_node)
        
        print(f"\n📦 TRANSFORMING {scan_count} REAL SCANS:")
        print(f"{'-'*70}")
        
        for index, scan in enumerate(scans):
            scan_id = str(scan.get("_id", f"table-{index}"))
            filename = scan.get('filename') or scan.get('datasource_name') or f'Scan_{index}'
            compliance_score = scan.get('compliance_score') or scan.get('dq_score') or 75.0
            has_pii = scan.get('has_pii', False)
            owner = scan.get('owner') or scan.get('created_by') or 'System'
            
            created_at = scan.get("created_at")
            if created_at and isinstance(created_at, datetime):
                last_scan = created_at.strftime("%Y-%m-%d")
            else:
                last_scan = datetime.now().strftime("%Y-%m-%d")
            
            y_position = index * 150 + 50
            
            table_node = LineageNodeOut(
                id=scan_id,
                label=filename,
                type='table',
                x=600,
                y=y_position,
                qualityScore=round(float(compliance_score), 1) if compliance_score else 0.0,
                hasPII=bool(has_pii),
                owner=owner,
                lastScan=last_scan
            )
            
            nodes.append(table_node)
            
            edge = {
                "id": f"edge-{scan_id}",
                "source": "warehouse-source",
                "target": scan_id
            }
            edges.append(edge)
            
            pii_flag = "🔒" if has_pii else "  "
            print(f"  [{index+1}] {filename[:40]:40} {compliance_score:5.1f}% {pii_flag}")
        
        total_time = asyncio.get_event_loop().time() - start_time
        print(f"{'-'*70}")
        print(f"✓ Total: {len(nodes)} nodes, {len(edges)} edges")
        print(f"✓ Response time: {total_time:.2f}s")
        print(f"{'='*70}\n")
        
        return LineageResponse(nodes=nodes, edges=edges)
        
    except asyncio.TimeoutError:
        elapsed = asyncio.get_event_loop().time() - start_time
        print(f"⏱️  TIMEOUT: Database query exceeded 2.0s (took {elapsed:.2f}s)")
        print(f"⚡ FAILOVER: Using mock data")
        print(f"{'='*70}\n")
        return generate_mock_data()
        
    except Exception as e:
        elapsed = asyncio.get_event_loop().time() - start_time
        print(f"❌ ERROR: {type(e).__name__}: {str(e)}")
        print(f"   Time before failure: {elapsed:.2f}s")
        print(f"⚡ FAILOVER: Using mock data")
        print(f"{'='*70}\n")
        return generate_mock_data()


