# ============================================================
# ADVANCED SCANNING ENDPOINTS (NEW v2.0)
# ============================================================

@app.post("/api/v2/scan/advanced")
async def advanced_scan(file: UploadFile = File(...)):
    """
    Advanced data quality scan with enterprise-grade validations
    
    NEW FEATURES:
    - Email/Phone validation with regex
    - Duplicate detection (entire rows and ID columns)
    - Negative value detection in price/age columns
    - Consistency checking (mixed capitalization)
    - Statistical outlier detection (IQR method)
    - Comprehensive null value analysis
    
    Returns detailed JSON with advanced_metrics object
    """
    
    if not file.filename.endswith(('.csv', '.xlsx', '.xls', '.json')):
        raise HTTPException(
            status_code=400,
            detail="Unsupported file type. Please upload CSV, Excel, or JSON files."
        )
    
    try:
        content = await file.read()
        scan_results = scan_uploaded_file(content, file.filename)
        
        return JSONResponse(content={
            "success": True,
            "message": "Advanced scan completed successfully",
            "data": scan_results
        })
        
    except Exception as e:
        raise HTTPException(
            status_code=500,
            detail=f"Error processing file: {str(e)}"
        )


@app.post("/api/v2/scan/report")
async def advanced_scan_with_report(file: UploadFile = File(...)):
    """
    Scan file with advanced rules and generate magazine-style PDF report
    
    Features:
    - Comprehensive data quality analysis
    - Advanced validation rules
    - Magazine-style executive dashboard
    - Two-column layout with score badge
    - Risk assessment calculation
    - Horizontal bar charts for quality dimensions
    - Sleek tables without vertical grid lines
    
    Returns PDF file for download
    """
    
    if not file.filename.endswith(('.csv', '.xlsx', '.xls', '.json')):
        raise HTTPException(
            status_code=400,
            detail="Unsupported file type"
        )
    
    try:
        content = await file.read()
        scan_results = scan_uploaded_file(content, file.filename)
        pdf_buffer = generate_pdf_report(scan_results)
        
        return StreamingResponse(
            pdf_buffer,
            media_type="application/pdf",
            headers={
                "Content-Disposition": f"attachment; filename=DHCaaS_Advanced_Report_{scan_results['scan_date']}.pdf"
            }
        )
        
    except Exception as e:
        raise HTTPException(
            status_code=500,
            detail=f"Error generating report: {str(e)}"
        )


