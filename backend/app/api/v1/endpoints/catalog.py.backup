"""
Data Catalog API Endpoints
Auto-discovery and smart tagging for datasets
"""

from typing import List, Optional
from fastapi import APIRouter, HTTPException, Query
from app.models.catalog import CatalogItem, CatalogListResponse
import logging

logger = logging.getLogger(__name__)

router = APIRouter()


@router.get("", response_model=CatalogListResponse)
async def list_catalog_items(
    page: int = Query(1, ge=1, description="Page number"),
    page_size: int = Query(20, ge=1, le=100, description="Items per page"),
    tags: Optional[str] = Query(None, description="Filter by tags (comma-separated)"),
    search: Optional[str] = Query(None, description="Search in name/description")
):
    """
    List all catalog items with pagination and filtering
    
    Features:
    - Pagination support
    - Filter by tags
    - Search by name/description
    """
    try:
        from app.core.database import get_database
        
        db = await anext(get_database())
        collection = db["dhcaas"]["catalog"]
        
        # Build query filter
        query_filter = {}
        
        if tags:
            tag_list = [t.strip() for t in tags.split(",")]
            query_filter["tags"] = {"$in": tag_list}
        
        if search:
            query_filter["$or"] = [
                {"name": {"$regex": search, "$options": "i"}},
                {"description": {"$regex": search, "$options": "i"}}
            ]
        
        # Get total count
        total = await collection.count_documents(query_filter)
        
        # Get paginated results
        skip = (page - 1) * page_size
        cursor = collection.find(query_filter).skip(skip).limit(page_size).sort("updated_at", -1)
        
        items_list = await cursor.to_list(length=page_size)
        
        # Convert to CatalogItem models
        catalog_items = []
        for item in items_list:
            try:
                item["_id"] = str(item["_id"])
                catalog_items.append(CatalogItem(**item))
            except Exception as e:
                logger.warning(f"Skipping invalid catalog item: {e}")
                continue
        
        logger.info(f"Retrieved {len(catalog_items)} catalog items (page {page})")
        
        return CatalogListResponse(
            total=total,
            items=catalog_items,
            page=page,
            page_size=page_size
        )
        
    except Exception as e:
        logger.error(f"Error listing catalog items: {str(e)}")
        # Return empty catalog instead of error
        return CatalogListResponse(
            total=0,
            items=[],
            page=page,
            page_size=page_size
        )


@router.get("/{item_id}", response_model=CatalogItem)
async def get_catalog_item(item_id: str):
    """Get a specific catalog item by ID"""
    try:
        from bson import ObjectId
        from app.core.database import get_database
        
        db = await anext(get_database())
        collection = db["dhcaas"]["catalog"]
        
        item = await collection.find_one({"_id": ObjectId(item_id)})
        
        if not item:
            raise HTTPException(status_code=404, detail="Catalog item not found")
        
        item["_id"] = str(item["_id"])
        
        logger.info(f"Retrieved catalog item: {item_id}")
        
        return CatalogItem(**item)
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error retrieving catalog item: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to retrieve catalog item: {str(e)}")


@router.get("/tags/popular")
async def get_popular_tags(limit: int = Query(10, ge=1, le=50, description="Maximum number of tags to return")):
    """
    Get most popular tags across all catalog items
    
    Returns:
        List of tags with their occurrence count
    """
    try:
        from app.core.database import get_database
        
        db = await anext(get_database())
        collection = db["dhcaas"]["catalog"]
        
        pipeline = [
            {"$unwind": "$tags"},
            {"$group": {"_id": "$tags", "count": {"$sum": 1}}},
            {"$sort": {"count": -1}},
            {"$limit": limit},
            {"$project": {"tag": "$_id", "count": 1, "_id": 0}}
        ]
        
        cursor = collection.aggregate(pipeline)
        tags = await cursor.to_list(length=limit)
        
        logger.info(f"Retrieved {len(tags)} popular tags")
        
        return tags
        
    except Exception as e:
        logger.error(f"Error getting popular tags: {str(e)}")
        # Return empty list instead of error
        return []


@router.delete("/{item_id}")
async def delete_catalog_item(item_id: str):
    """Delete a catalog item by ID"""
    try:
        from bson import ObjectId
        from app.core.database import get_database
        
        db = await anext(get_database())
        collection = db["dhcaas"]["catalog"]
        
        result = await collection.delete_one({"_id": ObjectId(item_id)})
        
        if result.deleted_count == 0:
            raise HTTPException(status_code=404, detail="Catalog item not found")
        
        logger.info(f"Deleted catalog item: {item_id}")
        
        return {"message": "Catalog item deleted successfully", "id": item_id}
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error deleting catalog item: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to delete catalog item: {str(e)}")


@router.get("/stats/summary")
async def get_catalog_statistics():
    """Get catalog statistics and overview"""
    try:
        from app.core.database import get_database
        
        db = await anext(get_database())
        collection = db["dhcaas"]["catalog"]
        
        # Total items
        total_items = await collection.count_documents({})
        
        # Average quality score
        pipeline_avg = [
            {"$group": {"_id": None, "avg_score": {"$avg": "$quality_score"}}}
        ]
        
        cursor = collection.aggregate(pipeline_avg)
        avg_result = await cursor.to_list(length=1)
        avg_score = round(avg_result[0]["avg_score"], 2) if avg_result else 0
        
        # Total rows across all datasets
        pipeline_rows = [
            {"$group": {"_id": None, "total_rows": {"$sum": "$row_count"}}}
        ]
        
        cursor = collection.aggregate(pipeline_rows)
        rows_result = await cursor.to_list(length=1)
        total_rows = rows_result[0]["total_rows"] if rows_result else 0
        
        # Count by tag
        pipeline_tags = [
            {"$unwind": "$tags"},
            {"$group": {"_id": None, "unique_tags": {"$addToSet": "$tags"}}}
        ]
        
        cursor = collection.aggregate(pipeline_tags)
        tags_result = await cursor.to_list(length=1)
        unique_tags = len(tags_result[0]["unique_tags"]) if tags_result else 0
        
        logger.info("Retrieved catalog statistics")
        
        return {
            "total_datasets": total_items,
            "average_quality_score": avg_score,
            "total_rows": total_rows,
            "unique_tags": unique_tags
        }
        
    except Exception as e:
        logger.error(f"Error getting catalog statistics: {str(e)}")
        return {
            "total_datasets": 0,
            "average_quality_score": 0,
            "total_rows": 0,
            "unique_tags": 0
        }
